TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Optional model settings
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ANALYSIS_MODEL=gpt-5.5
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Slower speech = longer audio from the same text (0.25-4.0, default 0.92)
TTS_SPEED=0.92
# OpenAI TTS allows up to 4096 chars per request; long replies are split into several voice messages
TTS_MAX_CHARS_PER_CHUNK=3800
DB_PATH=progress.db
